# Hyvision One Frontend - Development Environment

# API Configuration
# REACT_APP_API_URL을 비워 두면 브라우저 주소와 동일한 호스트로 API를 잡습니다.
# - http://localhost:3030 → http://localhost:5030/api
# - http://192.168.x.x:3030 → http://192.168.x.x:5030/api
# Railway 등 고정 URL이 필요할 때만 아래 주석을 해제하세요.
# REACT_APP_API_URL=https://your-api.example.com/api
# REACT_APP_WS_URL=wss://your-api.example.com

REACT_APP_HVO_SINGLE_COMPANY_MODE=true
REACT_APP_NAME=Hyvision One
REACT_APP_VERSION=3.0.0
REACT_APP_ENVIRONMENT=development

REACT_APP_ENABLE_DEBUG=true
REACT_APP_ENABLE_ANALYTICS=false
REACT_APP_ENABLE_SENTRY=false

REACT_APP_API_TIMEOUT=10000
REACT_APP_MAX_FILE_SIZE=10485760
REACT_APP_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

REACT_APP_DEFAULT_PAGE_SIZE=20
REACT_APP_MAX_PAGE_SIZE=100
REACT_APP_CACHE_TTL=300000
REACT_APP_CACHE_MAX_SIZE=50

REACT_APP_DEFAULT_THEME=light
REACT_APP_DEFAULT_LANGUAGE=ko

REACT_APP_ENABLE_HTTPS=false
REACT_APP_ENABLE_CSP=true
REACT_APP_ENABLE_REDUX_DEVTOOLS=true
REACT_APP_ENABLE_REACT_QUERY_DEVTOOLS=true
