# Hyvision One Frontend - Development Environment (reference / sync)

# CRA reads `.env.development` (with leading dot). Keep that file in sync.
# - http://localhost:3030 → http://localhost:5030/api

REACT_APP_NAME=Hyvision One
REACT_APP_VERSION=3.0.0
REACT_APP_ENVIRONMENT=development
REACT_APP_ENABLE_DEBUG=true
REACT_APP_API_TIMEOUT=10000
REACT_APP_DEFAULT_THEME=light
REACT_APP_DEFAULT_LANGUAGE=ko
