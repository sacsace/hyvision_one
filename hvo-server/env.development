# Hyvision One Backend Development Environment
# Isolated from MVS — DB must be hyvision_one @ 5433 only.
NODE_ENV=development
DISABLE_SYNC=true
PORT=5030
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3030

DB_HOST=localhost
DB_PORT=5433
DB_NAME=hyvision_one
DB_USER=hvo_user
DB_PASSWORD=Korean@2026

REDIS_HOST=localhost
REDIS_PORT=6379

JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long-for-development
SESSION_SECRET=your-session-secret-key-for-development

UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10mb
LOG_LEVEL=debug

CHOKIDAR_USEPOLLING=true
WATCHPACK_POLLING=true

DEFAULT_TENANT_ID=1
LOW_STOCK_THRESHOLD=10
HIGH_STOCK_THRESHOLD=100

HVO_SINGLE_COMPANY_MODE=true
